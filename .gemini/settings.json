{
  "behavior": {
    "autoConfirmFileWrites": false,
    "autoConfirmCommandExecution": false,
    "maxAutonomousSteps": 30,
    "language": "en",
    "workingDirectory": "."
  },
  "security": {
    "allowedCommands": [
      "flutter analyze",
      "flutter test",
      "dart run build_runner build --delete-conflicting-outputs",
      "flutter pub get",
      "git status"
    ],
    "blockedDirectories": [
      ".git",
      ".dart_tool",
      "build",
      "ios/Pods",
      "android/.gradle",
      "coverage"
    ],
    "preventSecretOutput": true
  },
  "tools": {
    "fileSystemRead": true,
    "fileSystemWrite": true,
    "terminalExecution": true,
    "webSearch": false
  },
  "prompts": {
    "systemInstructionFile": "AGENT.md"
  }
}